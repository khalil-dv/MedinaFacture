# IziFacture — variables d'environnement
# Dupliquez ce fichier en `.env.local` (développement) ou configurez ces
# variables dans votre plateforme d'hébergement (production).

# Projet Supabase → Dashboard > Settings > API
# URL du projet (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé PUBLISHABLE (sûre pour le navigateur, équivalent de l'ancienne anon)
# ⚠️ Ne JAMAIS utiliser la "Secret key" (sb_secret_...) côté navigateur :
# elle donne un accès privilégié et serait exposée publiquement.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (obligatoire en production pour l'email de confirmation,
# les redirections OAuth et le SEO). Ex: https://izifacture.vercel.app
NEXT_PUBLIC_SITE_URL=
